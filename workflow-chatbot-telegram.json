    {
      "parameters": {
        "jsCode": "const weatherData = $input.first().json;\n\nconst cityName = weatherData?.name;\nconst temperature = weatherData?.main?.temp;\nconst description = weatherData?.weather?.[0]?.description;\nconst statusCode = weatherData?.cod || $input.first().json?.error?.status;\nconst country = weatherData?.sys?.country;\nconst feelsLike = weatherData?.main?.feels_like;\nconst windSpeed = weatherData?.wind?.speed;\nconst humidity = weatherData?.main?.humidity;\n\nconst tempRounded = temperature !== null && temperature !== undefined ? Math.round(temperature) : null;\nconst feelsRounded = feelsLike !== null && feelsLike !== undefined ? Math.round(feelsLike) : null;\n\nlet emoji = \"🌡️\";\nif (description?.includes(\"chuva\") || description?.includes(\"chuvisco\")) emoji = \"🌧️\";\nelse if (description?.includes(\"nublado\") || description?.includes(\"nuvens\")) emoji = \"☁️\";\nelse if (description?.includes(\"limpo\") || description?.includes(\"céu\")) emoji = \"☀️\";\nelse if (description?.includes(\"neve\")) emoji = \"❄️\";\nelse if (description?.includes(\"trovoada\")) emoji = \"⛈️\";\n\nconst fallbackMessage = `${emoji} Clima em ${cityName} (${country})\\n🌡️ Temperatura: ${tempRounded}°C\\n🤗 Sensação: ${feelsRounded}°C\\n💧 Humidade: ${humidity}%\\n💨 Vento: ${windSpeed} m/s\\n${emoji} ${description}`;\n\nconst error = $input.first().json?.error?.description\n\nreturn {\n  json: {\n    city: cityName,\n    country: country,\n    temperature: temperature,\n    temperatureRounded: tempRounded,\n    feelsLike: feelsLike,\n    windSpeed: windSpeed,\n    humidity: humidity,\n    description: description,\n    fallback_message: fallbackMessage,\n    statusCode: statusCode,\n    error: error\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -448,
        96
      ],
      "id": "1b31b4fe-a382-4287-9faa-c95b5933cbdb",
      "name": "Processar Dados"
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "value": "models/gemini-3.1-flash-lite",
          "mode": "list",
          "cachedResultName": "models/gemini-3.1-flash-lite"
        },
        "messages": {
          "values": [
            {
              "content": "=Dados:\n- Cidade: {{ $json.city }}\n- Temperatura: {{ $json.temperatureRounded }}°C\n- Sensação térmica: {{ $json.feelsLike }}°C\n- Condição: {{ $json.description }}\n- Umidade: {{ $json.humidity }}%\n- Vento: {{ $json.windSpeed }} m/s"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "systemMessage": "=Você é um assistente de clima responsável por transformar dados meteorológicos em uma mensagem curta, natural e amigável em português brasileiro.\n\nInstruções:\n1. Crie uma mensagem natural e amigável em português brasileiro.\n2. Informe claramente o nome da cidade e a temperatura atual com base exclusivamente nos dados fornecidos.\n3. Use emojis apropriados à condição climática, quando essa informação estiver disponível.\n4. Forneça uma dica prática relacionada às condições climáticas informadas, somente quando fizer sentido.\n5. Nunca invente ou presuma informações sobre temperatura, chuva, vento, sensação térmica ou outras condições que não tenham sido fornecidas.\n6. Mantenha a mensagem concisa, com no máximo 5 linhas.\n7. NÃO cumprimente a cidade como se fosse uma pessoa.\n8. NÃO use saudações como \"E aí\", \"Olá\", \"Oi\", \"Bom dia\" ou similares no início da mensagem.\n9. Refira-se à cidade apenas como localização. Exemplo correto: \"Em São Paulo, a temperatura atual é de 25°C.\"\n10. NÃO assuma, invente ou mencione o nome do usuário.\n11. Não altere nem contradiga os dados meteorológicos recebidos.\n12. Responda sempre em português brasileiro.",
          "temperature": 0.2
        }
      },
